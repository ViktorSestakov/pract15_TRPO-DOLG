<Window x:Class="ElectronicsShop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Style="{StaticResource {x:Type Window}}"
        Title="Магазин электроники" Height="720" Width="1180"
        MinHeight="640" MinWidth="960" Loaded="LoadList">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Магазин электроники" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="RoleText" Foreground="#49636A" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="Back" Content="Сменить роль" Width="140"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" x:Name="ManagerPanel" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Click="Add" Content="Добавить товар" Width="160" Margin="0,0,10,0"/>
            <Button Click="GoToCategories" Content="Категории" Width="120" Margin="0,0,10,0"/>
            <Button Click="GoToBrands" Content="Бренды" Width="100" Margin="0,0,10,0"/>
            <Button Click="GoToTags" Content="Теги" Width="90"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" Padding="12" Margin="0,0,15,0">
                <StackPanel>
                    <TextBlock Text="Фильтры" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Категория" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CategoryBox" ItemsSource="{Binding Categories}"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectionChanged="FilterChanged" Margin="0,0,0,10"/>

                    <TextBlock Text="Бренд" Margin="0,0,0,5"/>
                    <ComboBox x:Name="BrandBox" ItemsSource="{Binding Brands}"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectionChanged="FilterChanged" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Цена от" Margin="0,0,0,5"/>
                            <TextBox x:Name="PriceFromBox" TextChanged="SearchChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Цена до" Margin="0,0,0,5"/>
                            <TextBox x:Name="PriceToBox" TextChanged="SearchChanged"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="FilterError" Foreground="#A52A2A" FontSize="11"
                               TextWrapping="Wrap" MinHeight="40" Margin="0,5,0,5"/>
                    <Button Click="Reset" Content="Сбросить" Margin="0,0,0,10"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Поиск по наименованию" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchBox" TextChanged="SearchChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Сортировка" Margin="0,0,0,5"/>
                        <ComboBox x:Name="SortBox" SelectedIndex="0" SelectionChanged="SortChanged">
                            <ComboBoxItem Tag="NameAsc" Content="Наименование: А → Я"/>
                            <ComboBoxItem Tag="NameDesc" Content="Наименование: Я → А"/>
                            <ComboBoxItem Tag="PriceAsc" Content="Цена: по возрастанию"/>
                            <ComboBoxItem Tag="PriceDesc" Content="Цена: по убыванию"/>
                            <ComboBoxItem Tag="StockAsc" Content="Остаток: по возрастанию"/>
                            <ComboBoxItem Tag="StockDesc" Content="Остаток: по убыванию"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Click="View" Content="Просмотреть" Width="140" Margin="0,0,10,0"/>
                    <Button x:Name="EditButton" Click="Edit" Content="Изменить" Width="115" Margin="0,0,10,0"/>
                    <Button x:Name="DeleteButton" Click="Delete" Content="Удалить" Width="110"/>
                </StackPanel>

                <ListView Grid.Row="2" x:Name="ProductsList" ItemsSource="{Binding service.Products}"
                          SelectedItem="{Binding selected}" MouseDoubleClick="ViewDoubleClick"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,5,10"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="2" Padding="12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#AEC8CA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                                <Setter Property="Background" Value="#E7FAF7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                <Setter Property="BorderBrush" Value="#ffd129"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" MinWidth="125"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,15,0">
                                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="#865F00" Margin="0,5,0,12">
                                            <Run Text="★ "/>
                                            <Run Text="{Binding Rating, StringFormat={}{0:F1}}"/>
                                            <Run Text=" / 5"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Category.Name}" FontWeight="Bold"/>
                                        <TextBlock Foreground="#49636A" Margin="0,4,0,5">
                                            <Run Text="Бренд: "/>
                                            <Run Text="{Binding Brand.Name}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding TagsText}" Foreground="#007D87" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        <TextBlock Text="Цена" Foreground="#49636A" HorizontalAlignment="Right" Margin="0,3,0,20"/>
                                        <TextBlock FontWeight="Bold" HorizontalAlignment="Right">
                                            <Run Text="Остаток: "/>
                                            <Run Text="{Binding Stock}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="2" x:Name="EmptyText" Text="Товары не найдены" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding service.Products.Count, StringFormat='Всего товаров в базе: {0}'}" FontWeight="Bold" Margin="0,0,25,0"/>
                <TextBlock Text="{Binding Items.Count, ElementName=ProductsList, StringFormat='Показано: {0}'}" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
